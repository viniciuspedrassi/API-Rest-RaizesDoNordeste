# Exemplo de variáveis de ambiente para execução local.
# Copie para um arquivo .env local e preencha com seus próprios valores.
# Não publique senhas nem a chave JWT real no GitHub.

# Conexão com o MySQL
DB_URL=jdbc:mysql://localhost:3306/raizes_do_nordeste
DB_USERNAME=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql

# Chave de assinatura dos tokens JWT (defina um segredo forte e privado)
JWT_SECRET=substitua_por_uma_chave_longa_aleatoria_e_privada

# Administrador inicial (utilizado com o perfil bootstrap-admin)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=substitua_por_uma_senha_forte
